
<%- include("partials/header.ejs") %>
    <% if(bloglist.length < 1) { %>
        <h1 class="no-blog-title">You don't have any blogs yet. Please visit <br /> the home page to create a new blog.
        </h1>
        <% } else { %>
            <h1 class="title">Your Blogs List</h1>
            <% } %>

                <div class="overflow-div">
                    <div class="home-container">
                        <% for(let index=0 ; index < bloglist.length ; index++){ %>
                            <div class="blog-card">
                                <span class="blog-number">
                                    <%= index+1 %>
                                </span>
                                <h4>
                                    <%= bloglist[index].title %>
                                </h4>
                                <p>
                                    <%= bloglist[index].description?.slice(0,300) %>
                                        <% if (bloglist[index].description?.length> 299){ %> ...
                                            <a calss="view-btn" href="/blogList/<%= bloglist[index].id %>">View
                                                Blog</a>
                                            <% } %>
                                </p>
                                <div class="btn-wrapper">
                                    <form action="/delete/<%= bloglist[index].id %>" method="post">
                                        <button class="delete-btn">Delete</button>
                                    </form>
                                    <a class="edit-btn" href="/edit/<%= bloglist[index].id %>">edit</a>
                                </div>
                            </div>
                            <% } %>
                    </div>
                </div>

<%- include("partials/footer.ejs") %>
